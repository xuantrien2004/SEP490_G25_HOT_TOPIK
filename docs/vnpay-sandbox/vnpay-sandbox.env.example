# Mẫu biến môi trường VNPay SANDBOX cho HOT TOPIK.
# Sao chép thành file riêng (KHÔNG commit), điền giá trị thật lấy từ email đăng ký VNPay Sandbox,
# rồi khai báo vào Run Configuration của IntelliJ (Environment variables).

# Mã website (Terminal ID) VNPay Sandbox gửi qua email
VNPAY_TMN_CODE=
# Chuỗi bí mật tạo checksum (Secret Key) – tuyệt đối không commit, không log
VNPAY_HASH_SECRET=

# URL thanh toán Sandbox (hệ thống chỉ chấp nhận host sandbox.vnpaytest.vn hoặc sandbox.vnpayment.vn)
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL API truy vấn giao dịch (QueryDR) của Sandbox
VNPAY_API_URL=https://sandbox.vnpaytest.vn/merchant_webapi/api/transaction
VNPAY_VERSION=2.1.0

# Trình duyệt học viên quay về sau khi thanh toán (localhost dùng được)
VNPAY_RETURN_URL=http://localhost:8080/payment/vnpay/return
# IPN: VNPay gọi server-to-server -> cần URL công khai (ngrok / Cloudflare Tunnel). Khai báo trên cổng merchant Sandbox.
VNPAY_IPN_URL=https://<ten-mien-tunnel>/payment/vnpay/ipn

# Thời gian chờ thanh toán của đơn hàng (phút)
PAYMENT_EXPIRATION_MINUTES=15

# Mặc định false. Bật true khi VNPay Sandbox không gửi IPN / QueryDR lỗi: xác nhận bằng Return URL có chữ ký hợp lệ (chỉ dùng demo)
VNPAY_ACCEPT_SIGNED_RETURN=false
